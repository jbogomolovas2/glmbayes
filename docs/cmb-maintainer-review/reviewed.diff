+
+    .cmb_tab <- function(m) {
+      um <- sort(unique(as.integer(m)))
+      if (any(um < 1L)) stop("CMB requires m >= 1")
+      if (all(um == 1L))
+        stop("all m = 1: log choose(1, y) is 0 and nu is unidentified")
+      tabs <- lapply(um, function(mm) list(j = 0:mm, t = lchoose(mm, 0:mm)))
+      names(tabs) <- as.character(um)
+      tabs
